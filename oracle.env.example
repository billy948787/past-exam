# Copy to oracle.env, set permissions to 600, and fill every secret locally.
POSTGRES_DB=past_exam
POSTGRES_USER=past_exam
POSTGRES_PASSWORD=
REDIS_PASSWORD=

HASH_KEY=

# Existing Cloudflare R2 settings. Keep the existing bucket and public URL.
R2_URL=
R2_ACCESS_KEY=
R2_ACCESS_TOKEN=
R2_BUCKET_NAME=
R2_FILE_PATH=

FRONTEND_ORIGIN=https://past-exam.ntpu.cc
NEXT_PUBLIC_API_ORIGIN=https://past-exam-api.ntpu.cc
NEXT_PUBLIC_GOOGLE_LOGIN_CLIENT_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_MEASUREMENT_ID=
NEXT_PUBLIC_GIT_BRANCH=main

GOOGLE_SERVICE_CLIENT_ID=
GOOGLE_SERVICE_SERCET=
AWS_EMAIL_SENDER=
AWS_ACCESS_KEY=
AWS_ACCESS_SECRET=
LOG_TAIL_SOURCE_KEY=
SERVICE_NAME=oracle-production
COMMIT_SHA=unknown
